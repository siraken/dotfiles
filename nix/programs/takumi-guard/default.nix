# Takumi Guard (https://shisho.dev/docs/ja/t/guard/): route package installs
# through GMO Flatt Security's registry proxy, which rejects known-malicious
# packages and, with a token, records downloads so a later advisory can be
# mailed back.
#
# The token lives in secrets.toml (`[takumiGuard] token`), which is read at
# *activation* time only, like git-personas: the flake stays pure and the token
# never reaches the Nix store. That rules out `home.file`, so the files below
# are regular 0600 files written by an activation script instead of symlinks.
# Without a token (no secrets.toml, or no `takumiGuard` table) the same files
# are written without credentials, which still blocks but does not track.
#
# The files are owned wholesale: anything added to them by hand (`npm config
# set`, `bundle config set --global`, …) is replaced on the next switch, after
# the hand-edited copy is moved aside to `<file>.hm-backup`. Declare such
# settings here instead.
#
# Covered: npm / pnpm / bun (~/.npmrc), yarn berry (~/.yarnrc.yml), pip
# (pip.conf), uv (uv.toml) and Bundler (~/.bundle/config). Each tool reads only
# its own file, so a tool missing from this list is not protected.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  secretsFile = "${config.dotfiles.path}/secrets.toml";

  # Kept from the hand-written ~/.npmrc this module replaces.
  npmrcExtra = [ "minimum-release-age=1440" ];

  writeConfigs = pkgs.writeShellApplication {
    name = "takumi-guard-config";
    runtimeInputs = [
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.jq
      pkgs.yq-go
    ];
    text = ''
      usage="usage: takumi-guard-config <secrets.toml> <home> <xdg-config-home>"
      secrets="''${1:?$usage}"
      home="''${2:?$usage}"
      xdg="''${3:?$usage}"
      marker="Generated by home-manager (nix/programs/takumi-guard). Do not edit."

      token=""
      if [ -r "$secrets" ]; then
        token="$(yq -p toml -o json "$secrets" | jq -r '.takumiGuard.token // empty')"
      fi
      # The token is pasted into URLs and config files below, so accept only
      # the documented shape rather than escaping for five formats.
      if [ -n "$token" ] && ! [[ "$token" =~ ^tg_(anon|org)_[A-Za-z0-9_-]+$ ]]; then
        echo "takumi-guard: takumiGuard.token in $secrets is not a tg_anon_/tg_org_ token; writing anonymous configuration" >&2
        token=""
      fi

      auth=""
      if [ -n "$token" ]; then
        auth="token:$token@"
      fi

      # put <path>: write stdin to <path> as a 0600 file. A file this
      # script did not write is moved aside first.
      put() {
        local path="$1" tmp backup
        mkdir -p "$(dirname "$path")"
        tmp="$(mktemp "$path.XXXXXX")"
        cat >"$tmp"
        chmod 600 "$tmp"

        if [ -f "$path" ] && ! [ -L "$path" ] && cmp -s "$tmp" "$path"; then
          rm -f "$tmp"
          return
        fi
        if { [ -e "$path" ] || [ -L "$path" ]; } && ! grep -qF "$marker" "$path" 2>/dev/null; then
          backup="$path.hm-backup"
          [ -e "$backup" ] && backup="$backup.$(date +%Y%m%d%H%M%S)"
          mv "$path" "$backup"
          echo "takumi-guard: moved existing $path to $backup" >&2
        fi
        mv "$tmp" "$path"
      }

      # npm, pnpm and bun. pnpm reads auth tokens from this user-level file
      # only, never from a project's .npmrc.
      {
        echo "# $marker"
        ${lib.concatMapStrings (line: "echo ${lib.escapeShellArg line}\n") npmrcExtra}
        echo "registry=https://npm.flatt.tech/"
        if [ -n "$token" ]; then
          echo "//npm.flatt.tech/:_authToken=$token"
        fi
      } | put "$home/.npmrc"

      # yarn berry. Without npmAlwaysAuth inside npmRegistries, the token is
      # not sent for unscoped packages.
      {
        echo "# $marker"
        echo 'npmRegistryServer: "https://npm.flatt.tech/"'
        if [ -n "$token" ]; then
          echo 'npmRegistries:'
          echo '  "https://npm.flatt.tech/":'
          echo "    npmAuthToken: \"$token\""
          echo '    npmAlwaysAuth: true'
        fi
      } | put "$home/.yarnrc.yml"

      # pip. It ignores uv.toml, and uv ignores pip.conf.
      {
        echo "# $marker"
        echo "[global]"
        echo "index-url = https://''${auth}pypi.flatt.tech/simple/"
      } | put "$xdg/pip/pip.conf"

      {
        echo "# $marker"
        echo "[[index]]"
        echo "url = \"https://''${auth}pypi.flatt.tech/simple/\""
        echo "default = true"
      } | put "$xdg/uv/uv.toml"

      # Bundler: mirror rubygems.org rather than replace the source, so
      # Gemfiles keep `source "https://rubygems.org"`.
      {
        echo "---"
        echo "# $marker"
        echo "BUNDLE_MIRROR__HTTPS://RUBYGEMS__ORG/: \"https://''${auth}rubygems.flatt.tech/\""
      } | put "$home/.bundle/config"
    '';
  };
in
{
  home.activation.takumiGuard = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    run ${lib.getExe writeConfigs} \
      ${lib.escapeShellArg secretsFile} \
      "$HOME" \
      ${lib.escapeShellArg config.xdg.configHome}
  '';
}
