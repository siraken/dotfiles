// Waybar for Hyprland on NixOS (siraken-mba). Started by
// config/hypr-nixos/autostart.lua; SUPER + SHIFT + SPACE toggles it.
// See https://github.com/Alexays/Waybar/wiki
//
// Laid out like siraken-mbp's Sketchybar: a transparent bar with floating
// "islands" (groups styled in style.css).
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "margin-top": 4,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["group/spaces", "group/app"],
  "modules-center": ["group/time"],
  "modules-right": ["mpris", "group/indicators", "group/system"],

  "group/spaces": { "orientation": "horizontal", "modules": ["hyprland/workspaces"] },
  "group/app": { "orientation": "horizontal", "modules": ["hyprland/window"] },
  "group/time": { "orientation": "horizontal", "modules": ["clock"] },
  "group/indicators": { "orientation": "horizontal", "modules": ["tray", "idle_inhibitor"] },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "network",
      "wireplumber",
      "backlight",
      "power-profiles-daemon",
      "battery",
      "custom/notification",
      "custom/power",
    ],
  },

  // The number, then an icon per window, like siraken-mbp's spaces.
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}{windows}",
    "format-window-separator": "",
    "window-rewrite-default": " ",
    "window-rewrite": {
      "class<org.wezfurlong.wezterm>": " ",
      "class<foot>": " ",
      "class<google-chrome>": " ",
      "class<org.gnome.Nautilus>": " ",
      "class<1password>": " ",
      "class<code>": " ",
      "class<.*[Ss]lack.*>": " ",
      "class<.*[Dd]iscord.*>": " ",
      "class<.*[Ss]potify.*>": " ",
    },
    "persistent-workspaces": { "*": 5 },
  },

  "hyprland/window": {
    "format": "{class}",
    "max-length": 32,
    "rewrite": {
      "org.wezfurlong.wezterm": "WezTerm",
      "google-chrome": "Chrome",
      "org.gnome.Nautilus": "Files",
      "": "Desktop",
    },
    "separate-outputs": true,
  },

  "clock": {
    "format": "{:%a %m/%d  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "today": "<span color='#7aa2f7'><b>{}</b></span>",
        "weeks": "<span color='#565f89'>{}</span>",
      },
    },
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "max-length": 36,
    "player-icons": { "default": "", "spotify": "", "chromium": "" },
    "status-icons": { "paused": "" },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
  },

  "tray": { "spacing": 10, "icon-size": 15 },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" },
    "tooltip-format-activated": "Idle inhibited",
    "tooltip-format-deactivated": "Idle allowed",
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "uwsm-app -- blueman-manager",
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) {ipaddr}",
    "on-click": "uwsm-app -- nm-connection-editor",
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["", "", ""],
    "on-click": "uwsm-app -- pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
  },

  // No device: the panel's backlight is acpi_video0 with acpi_osi=.
  "backlight": {
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl -q set 5%+",
    "on-scroll-down": "brightnessctl -q set 5%-",
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },

  "battery": {
    "interval": 30,
    "states": { "warning": 20, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}, {power} W",
  },

  // swaync's notification center; the icon shows unread notifications and
  // do-not-disturb.
  "custom/notification": {
    "exec": "swaync-client --subscribe-waybar",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "none": "\uf0f3",
      "notification": "\uf0f3\u2022",
      "dnd-none": "\uf1f6",
      "dnd-notification": "\uf1f6\u2022",
    },
    "tooltip": false,
    "on-click": "swaync-client --toggle-panel --skip-wait",
    "on-click-right": "swaync-client --toggle-dnd --skip-wait",
    "escape": true,
  },

  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "on-click": "pkill wlogout || wlogout -b 3 -T 280 -B 280",
  },
}
