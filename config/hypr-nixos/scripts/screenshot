#!/usr/bin/env bash
# Screenshot to ~/Pictures/Screenshots and the clipboard.
#   screenshot region   pick a region (PRINT)
#   screenshot screen   the focused monitor (SHIFT + PRINT)
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-region}" in
  region)
    geometry=$(slurp -d) || exit 0
    grim -g "$geometry" "$file"
    ;;
  screen)
    output=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')
    grim -o "$output" "$file"
    ;;
  *)
    echo "usage: screenshot [region|screen]" >&2
    exit 2
    ;;
esac

wl-copy --type image/png <"$file"
notify-send -u low -i "$file" "Screenshot saved" "$file"
