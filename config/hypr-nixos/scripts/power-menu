#!/usr/bin/env bash
# System menu (SUPER + ESCAPE, power button): lock, suspend, hibernate, log out,
# reboot, power off.
choice=$(printf '%s\n' Lock Suspend Hibernate "Log out" Reboot "Power off" |
  fuzzel --dmenu --prompt 'System: ' --lines 6) || exit 0

case "$choice" in
  Lock) loginctl lock-session ;;
  Suspend) systemctl suspend ;;
  Hibernate) systemctl hibernate ;;
  "Log out") uwsm stop ;;
  Reboot) systemctl reboot ;;
  "Power off") systemctl poweroff ;;
esac
