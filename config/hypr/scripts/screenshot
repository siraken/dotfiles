#!/usr/bin/env bash
# Screenshot to ~/Pictures/Screenshots and the clipboard. The notification
# offers to annotate it in satty, which saves over the file and copies again.
#   screenshot region   pick a region (PRINT)
#   screenshot window   the focused window (CTRL + PRINT)
#   screenshot screen   the focused monitor (SHIFT + PRINT)
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-region}" in
  region)
    geometry=$(slurp -d) || exit 0
    grim -g "$geometry" "$file"
    ;;
  window)
    geometry=$(hyprctl -j activewindow | jq -r 'if .at then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else empty end')
    [[ -n $geometry ]] || exit 0
    grim -g "$geometry" "$file"
    ;;
  screen)
    output=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')
    grim -o "$output" "$file"
    ;;
  *)
    echo "usage: screenshot [region|window|screen]" >&2
    exit 2
    ;;
esac

wl-copy --type image/png <"$file"

# The action waits for the notification, so it runs in the background.
(
  # 10 s: once the popup is gone, so is its action.
  action=$(notify-send -t 10000 -i "$file" -A annotate=Annotate "Screenshot saved" "$file") || exit 0
  if [[ $action == annotate ]]; then
    satty --filename "$file" --output-filename "$file" \
      --copy-command wl-copy --early-exit --actions-on-enter save-to-file
  fi
) </dev/null >/dev/null 2>&1 &
disown
