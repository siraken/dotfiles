# Notifications for Hyprland on NixOS (siraken-mba). Started by
# config/hypr-nixos/autostart.lua. See mako(5).

font=JetBrainsMono Nerd Font 10
background-color=#1a1b26f2
text-color=#c0caf5
border-color=#33ccff
border-size=2
width=360
padding=10
margin=10
anchor=top-right
default-timeout=5000
max-icon-size=48

[urgency=critical]
border-color=#f7768e
default-timeout=0

# SUPER + CTRL + comma
[mode=do-not-disturb]
invisible=1
