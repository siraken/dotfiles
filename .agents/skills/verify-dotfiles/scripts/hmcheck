#!/usr/bin/env bash
# hmcheck - read-only checks that a change in this checkout reaches the
# running machine. Everything except `build` / `cleanup` is evaluation only:
# store paths are computed with `nix eval`, never built, and compared with
# what the live profiles resolve to.
#
# Usage: hmcheck <command> [args]
#   doctor          checkout, tools, flake evaluation and live-state report
#   fresh           is the evaluated home generation the live one? (exit 1 if not)
#   fresh-system    the same for the nix-darwin / NixOS system
#   diff            home.file targets added / removed / changed vs the live profile
#   resolve REL     what the checkout puts at ~/REL, and what ~/REL is now
#   units           launchd agents (macOS) / systemd user units (Linux) declared
#   build           build the activation package (out-link outside the repo)
#   cleanup         remove the out-links `build` created
#
# Environment:
#   HMCHECK_HOME    homeConfigurations attribute (default: $USER@$(hostname -s))
#   HMCHECK_HOST    darwin/nixosConfigurations attribute (default: hostname -s)
set -euo pipefail

root="$(git -C "$(dirname "$(realpath "$0")")" rev-parse --show-toplevel)"
host="${HMCHECK_HOST:-$(hostname -s)}"
home_attr="${HMCHECK_HOME:-${USER}@${host}}"
proof="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/hmcheck"

die() {
  echo "hmcheck: $*" >&2
  exit 2
}

need() {
  command -v "$1" >/dev/null || die "$1 not found on PATH"
}

# One evaluation of everything the commands need; `nix eval` of this flake
# takes tens of seconds, so it is never repeated within a command.
eval_home() {
  nix eval --json "${root}#homeConfigurations.\"${home_attr}\"" --apply '
    h: {
      generation = h.activationPackage.outPath;
      homeFiles = h.config.home-files.outPath;
      linkMode = h.config.dotfiles.linkMode or null;
      files = map (f: {
        inherit (f) target recursive;
        source = toString f.source;
      }) (builtins.filter (f: f.enable) (builtins.attrValues h.config.home.file));
      launchd = builtins.attrNames (h.config.launchd.agents or { });
      systemd = builtins.attrNames (h.config.systemd.user.services or { })
        ++ builtins.attrNames (h.config.systemd.user.timers or { });
    }' 2> >(grep -v "Git tree .* is dirty" >&2)
}

live_profile() {
  local p
  for p in "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" \
    "/nix/var/nix/profiles/per-user/${USER}/home-manager"; do
    if [ -e "$p" ]; then
      readlink -f "$p"
      return
    fi
  done
}

system_attr() {
  case "$(uname -s)" in
    Darwin) echo "darwinConfigurations.\"${host}\".system.outPath" ;;
    *) echo "nixosConfigurations.\"${host}\".config.system.build.toplevel.outPath" ;;
  esac
}

cmd_doctor() {
  local rc=0 e live
  echo "== checkout"
  echo "root:          ${root}"
  echo "commit:        $(git -C "$root" rev-parse --short HEAD)"
  echo "dirty files:   $(git -C "$root" status --porcelain | wc -l | tr -d ' ')"
  echo
  echo "== tools"
  for t in nix jq git; do
    if command -v "$t" >/dev/null; then echo "$t: ok"; else
      echo "$t: MISSING"
      rc=1
    fi
  done
  [ "$rc" -eq 0 ] || return "$rc"
  echo
  echo "== evaluation (${home_attr})"
  if ! e="$(eval_home)"; then
    echo "FAILED: homeConfigurations.\"${home_attr}\" does not evaluate"
    echo "(set HMCHECK_HOME if this host has another attribute name)"
    return 1
  fi
  jq -r '"generation:    \(.generation)",
         "home-files:    \(.homeFiles)",
         "linkMode:      \(.linkMode)",
         "home.file:     \(.files | length) entries",
         "launchd:       \(.launchd | length) agents",
         "systemd user:  \(.systemd | length) units"' <<<"$e"
  echo
  echo "== live"
  live="$(live_profile || true)"
  if [ -z "$live" ]; then
    echo "no home-manager profile on this host"
  else
    echo "generation:    ${live}"
    echo "home-files:    $(readlink -f "${live}/home-files")"
    report_fresh "$e" "$live" || true
  fi
}

# Prints FRESH / STALE and returns 1 when stale.
report_fresh() {
  local e="$1" live="$2" gen files
  gen="$(jq -r .generation <<<"$e")"
  files="$(jq -r .homeFiles <<<"$e")"
  if [ "$gen" = "$live" ]; then
    echo "FRESH: the live generation is this checkout"
    return 0
  fi
  if [ "$files" = "$(readlink -f "${live}/home-files")" ]; then
    echo "STALE (activation only): home-files match, but packages, environment"
    echo "or agents differ from the live generation"
  else
    echo "STALE: ~/ still shows an older configuration; see \`hmcheck diff\`"
  fi
  return 1
}

cmd_fresh() {
  local e live
  e="$(eval_home)" || die "evaluation failed"
  live="$(live_profile)" || true
  [ -n "$live" ] || die "no home-manager profile on this host"
  report_fresh "$e" "$live"
}

cmd_fresh_system() {
  local want have
  want="$(nix eval --raw "${root}#$(system_attr)" 2> >(grep -v "Git tree .* is dirty" >&2))" ||
    die "system configuration \"${host}\" does not evaluate"
  have="$(readlink -f /run/current-system)"
  echo "evaluated: ${want}"
  echo "live:      ${have}"
  if [ "$want" = "$have" ]; then
    echo "FRESH"
  else
    echo "STALE"
    return 1
  fi
}

cmd_diff() {
  local e live lf
  e="$(eval_home)" || die "evaluation failed"
  live="$(live_profile)" || true
  [ -n "$live" ] || die "no home-manager profile on this host"
  lf="$(readlink -f "${live}/home-files")"
  # Live links as {target: link}, relative to home-files.
  (cd "$lf" && find . -type l -print0 | while IFS= read -r -d '' l; do
    printf '%s\t%s\n' "${l#./}" "$(readlink "$l")"
  done) |
    jq -R -s --argjson e "$e" -r '
      (split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: .[1]})
        | from_entries) as $live
      | ($e.files | map(select(.recursive)) | map(.target)) as $rec
      | def under($t): . as $p | $rec | any(. as $r | $p | startswith($r + "/"));
      ( $e.files[] | select(.recursive | not)
        | if $live[.target] == null then "+ \(.target)"
          elif $live[.target] != .source then "~ \(.target)"
          else empty end ),
      ( $e.files[] | select(.recursive) | . as $f
        | [$live | to_entries[] | select(.key | startswith($f.target + "/"))
            | select(.value | startswith($f.source) | not)]
        | if length > 0 then "~ \($f.target)/ (\(length) files)" else empty end ),
      ( ($e.files | map(.target)) as $targets
        | $live | keys[] | select(. as $k | $targets | index($k) | not)
        | select(under(.) | not) | "- \(.)" )
    '
}

cmd_resolve() {
  local rel="${1:-}" e
  [ -n "$rel" ] || die "usage: hmcheck resolve REL (path relative to ~)"
  rel="${rel#\~/}"
  e="$(eval_home)" || die "evaluation failed"
  echo "== checkout"
  jq -r --arg t "$rel" '
    "linkMode: \(.linkMode)",
    (.files | map(select(. as $f | $f.target == $t or ($t | startswith($f.target + "/")))) |
      if length == 0 then "no home.file entry covers ~/\($t)"
      else .[] | "entry:    ~/\(.target)\(if .recursive then " (recursive)" else "" end)",
                 "source:   \(.source)" end)' <<<"$e"
  echo
  echo "== live"
  if [ -e "$HOME/$rel" ] || [ -L "$HOME/$rel" ]; then
    echo "link:     $(readlink "$HOME/$rel" || echo '(not a symlink)')"
    echo "resolves: $(readlink -f "$HOME/$rel")"
  else
    echo "~/${rel} does not exist"
  fi
}

cmd_units() {
  eval_home | jq -r '
    (.launchd[] | "launchd  \(.)"),
    (.systemd[] | "systemd  \(.)")'
}

cmd_build() {
  mkdir -p "$proof"
  nix build "${root}#homeConfigurations.\"${home_attr}\".activationPackage" \
    --out-link "${proof}/result-home" --print-out-paths
}

cmd_cleanup() {
  rm -f "${proof}"/result-*
  echo "removed out-links under ${proof}"
}

need nix
need jq
case "${1:-}" in
  doctor) cmd_doctor ;;
  fresh) cmd_fresh ;;
  fresh-system) cmd_fresh_system ;;
  diff) cmd_diff ;;
  resolve)
    shift
    cmd_resolve "$@"
    ;;
  units) cmd_units ;;
  build) cmd_build ;;
  cleanup) cmd_cleanup ;;
  *) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' && exit 2 ;;
esac
